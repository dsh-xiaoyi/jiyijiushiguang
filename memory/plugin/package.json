{
  "name": "dsh-memory-bridge",
  "version": "0.1.0",
  "type": "module",
  "main": "index.mjs",
  "description": "把三台机器共用的 DSH 长期记忆注入每个会话的系统提示 —— 新会话不再是白纸。",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory"
  ],
  "license": "MIT"
}
